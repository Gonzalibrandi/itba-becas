# Copiá este archivo como .env y completá los valores.

# Conexión a MongoDB. En local podés usar un Mongo propio o el de Northflank
# (con "northflank forward addon"). En Northflank se carga desde el secret group.
MONGODB_URI=mongodb://localhost:27017/becas-cursos

# Puerto de la API
PORT=3001

# Orígenes permitidos (separados por coma). Si queda vacío, se permite cualquiera.
# Ejemplo en producción:
# CORS_ORIGIN=https://mi-proyecto.pages.dev,https://*.mi-proyecto.pages.dev
CORS_ORIGIN=
